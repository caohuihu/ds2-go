# ╔══════════════════════════════════════════════════════════════════╗
# ║              deepseek2api-go 环境变量配置模板                    ║
# ║                                                                  ║
# ║  复制此文件为 .env 并填入实际值，然后：                          ║
# ║    docker compose -f docker-compose-ghcr.yml up -d              ║
# ║                                                                  ║
# ║  想要直接可用的"抗风控最佳实践"预设（多账号长期挂机）？          ║
# ║    改用 .env.risk-hardened.example 复制为 .env                   ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── 必需 ──────────────────────────────────────────────────────────

# 代理服务密钥：客户端调用时使用的认证 key。
# 单客户端：填一个 key 即可。
# 多客户端隔离（推荐）：留空，改用下方 PROXY_KEYS_FILE 里的多个 key，
#   每个客户端（思源 / opencode / …）各填一个不同的 key，
#   各自的会话在 DeepSeek 网页端彻底隔离、互不串台。
# 注意：至少要有 1 个 key（本行 或 PROXY_KEYS_FILE 里），否则启动报错。
PROXY_API_KEY=my-secret-key

# 多客户端密钥文件（每行一个 key，支持 # 注释和空行；与 PROXY_API_KEY 合并去重）。
# 留空 / 文件不存在 = 仅用上面的 PROXY_API_KEY 单 key。
# 示例（思源、opencode 各一个 key）：
#   siyuan-2026-x7f3a9b2c1   # 思源笔记
#   opencode-2026-4d8e5f6a7  # opencode
# 群晖上把该文件挂进容器：./proxy-keys.txt:/app/proxy-keys.txt:ro
PROXY_KEYS_FILE=proxy-keys.txt

# ─── DeepSeek 账号 ─────────────────────────────────────────────────

# 单账号 token（也可通过 accounts.txt 文件配置多账号）
# 获取方式：浏览器登录 chat.deepseek.com → F12 Console →
#           JSON.parse(localStorage.userToken).value
DEEPSEEK_TOKEN=

# 多账号文件路径（每行一个 token，支持 # 注释和空行）
DEEPSEEK_ACCOUNTS_FILE=accounts.txt

# ─── 服务基础配置 ──────────────────────────────────────────────────

# 监听端口（容器内端口，固定 8080）
PORT=8080

# 上游 DeepSeek 网页端地址（一般无需修改）
DEEPSEEK_BASE_URL=https://chat.deepseek.com

# 默认模型（请求未指定 model 时使用）
# 可用值：deepseek-chat / deepseek-reasoner / deepseek-search / deepseek-reasoner-search
DEFAULT_MODEL=deepseek-chat

# ─── 会话管理 ──────────────────────────────────────────────────────

# 每次新建会话随机从以下选项中选一个 TTL，打乱删除节奏
# 0 = 永不删除（模拟真实用户保留部分旧对话）
# 示例：10m,60m,2h,5h,0 → 约 20% 概率永不删除
CONVERSATION_TTL_OPTIONS=10m,60m,2h,5h,0

# 内存中最多保留的会话数（超出 LRU 淘汰最旧会话）
MAX_CONVERSATIONS=1024

# 会话重置概率：每次请求有 X% 概率主动开新会话（0~1 之间的小数）
# Strategy 2（prefix 命中时）和 Strategy 3（兜底最近会话时）均生效
#
# 效果对照：
#   0.0  → 永远不重置（一个会话用到底）
#   0.15 → 默认值，约每 7 条消息开 1 个新会话
#   0.3  → 较激进，约每 3 条消息开 1 个新会话
#   0.5  → 一半概率重置
#   1.0  → 每次都开新会话
#
# 注意：如果同时设置了 REQUESTS_PER_SESSION，优先使用该确定性控制。
SESSION_RESET_CHANCE=0.15

# 每个 DeepSeek 会话最多处理的请求数（确定性控制，优先于 SESSION_RESET_CHANCE）
# 0 = 关闭（仅依赖 SESSION_RESET_CHANCE 随机控制）
# 推荐值：
#   5  → 每 5 条消息强制开新会话 → 10 条消息约 2 个会话
#   8  → 每 8 条消息强制开新会话 → 16 条消息约 2 个会话
#   10 → 每 10 条消息强制开新会话 → 20 条消息约 2 个会话
# 如需 3-5 个会话持续运行，建议设为 5~8
REQUESTS_PER_SESSION=0

# 日志文件路径（可选）
# 留空 = 只输出到 stdout（docker logs 可见）
# 设置为容器内路径（如 /app/logs/app.log）= 同时写入文件，挂载宿主机后可用 tail/cat 查看
LOG_FILE=/app/logs/app.log

# ─── 风控限流 ──────────────────────────────────────────────────────

# 每账号每分钟最大请求数（令牌桶）
# 正常人使用约 1-6 QPM（每条间隔 10-60 秒）
# 值越大风险越高，建议不超过 15
ACCOUNT_QPM=6

# 每账号同时进行的最大并发请求数（= 同时运行的网页会话数上限）
# 单账号建议不超过 5，超过易触发风控
# 如需更多并发，请增加账号数（多个 token）
MAX_CONCURRENT_PER_ACCOUNT=5

# ─── 429 重试策略 ──────────────────────────────────────────────────

# 遇到 429 时最大重试次数（每次重试自动切换到下一个账号）
RETRY_MAX_ATTEMPTS=3

# 指数退避基础延迟：第 1 次等 2s，第 2 次等 4s，第 3 次等 8s…
# 最大不超过 5 分钟
RETRY_BASE_DELAY=2s

# ─── 行为随机化（降低指纹相似度） ──────────────────────────────────

# 每次发送 Completion 请求前的随机等待时间范围（模拟人类思考间隔）
REQUEST_JITTER_MIN=200ms
REQUEST_JITTER_MAX=800ms

# POW 求解器的模拟计算延迟范围
# 浏览器解题通常需要 30-150ms，Go 实现毫秒级完成
# 此参数让响应时间更贴近真实浏览器行为
POW_JITTER_MIN=30ms
POW_JITTER_MAX=150ms

# 新建会话前的随机延迟（防止批量创建会话的机器特征）
SESSION_CREATE_JITTER=200ms

# ─── 账号间冷却（模拟阅读回复时间） ───────────────────────────────

# 同一账号两次请求之间的最小/最大等待时间
# 真实用户在收到回复后通常会读几秒再发下一条
REQUEST_READ_TIME_MIN=5s
REQUEST_READ_TIME_MAX=30s

# ─── 设备指纹轮换 ──────────────────────────────────────────────────

# Device ID 定期轮换间隔（小时）
# 0 = 永不轮换（默认）
# 建议生产环境设为 24 或 72
# 轮换后同一账号的新请求会使用新的设备指纹
DEVICE_ID_ROTATE_HOURS=0

# ─── 账号健康检测（token 失效探测） ───────────────────────────────

# 启动时对全部账号做一次轻量探测（无副作用的鉴权请求）
STARTUP_ACCOUNT_CHECK=true

# 周期探测所有存活账号的间隔（0 = 关闭）
HEALTH_PROBE_INTERVAL=30m

# 对被隔离账号的重试间隔（token 换新后用于自动复活，0 = 关闭）
HEALTH_PROBE_DEAD_RETRY=10m

# 检测日志文件：隔离/复活/摘要事件写到这里，token 只显示首尾掩码
# 留空 = 自动放在 LOG_FILE 同目录（如 LOG_FILE=/app/logs/app.log → /app/logs/deepseek-health.log）
# 直接 tail -f 该文件即可知道哪个 token 失效
HEALTH_LOG_FILE=

# ─── 账号级风控（429 退避 / 封禁熔断） ─────────────────────────────

# 429 账号级退避（内置，无需配置）：每撞一次 429，该账号进入
# 60s × 2^(连撞次数-1) 冷却（60s→120s→240s…封顶 900s），期间新会话
# 自动漂移到其他账号；一次成功完成即清零。全池都在冷却时，
# 剩余冷却 ≤45s 的最快账号放行，避免全池 503。

# 检测到封禁措辞（封禁/账号异常/banned/suspended…，仅错误路径匹配）时，
# 该账号被隔离并"保持"这么久不再探测、不再使用（避免反复戳已封账号
# 加重风控）。到期后自动恢复探测，探测成功即复活。
# 168 = 7 天（默认）；0 = 长期保持，直到探测成功
BAN_QUARANTINE_HOURS=168

# 每账号每天最多处理的请求数（按本地日期归零，计数落盘到
# <DATA_DIR>/daily-usage.json，重启不清零）。达到后新会话自动漂移到
# 未达标的账号；全部账号都达标时新会话请求 503（午夜后恢复），
# 已缓存的会话不受影响。0 = 不限（默认）
# 建议长期挂机跑任务时设为 100~150，给账号留余量
DAILY_REQUEST_LIMIT=0

# 拟人长停顿：每个请求（agent 工具循环除外）有该概率额外随机等待
# 20~60s（模拟"去倒杯水"），让请求节奏更不像机器。0 = 关（默认）
# 建议 0.02（2%）左右；配合 REQUEST_READ_TIME_MIN/MAX 的 5~30s 阅读间隔使用
LONG_PAUSE_CHANCE=0

# ─── 静默自动续写 / 风控可观测 ───────────────────────────────────

# 静默自动续写：上游偶尔"成功但静默"（200 且正文、思考都为空，长任务
# 静默卡死的典型形态）。开启后在同一网页会话里自动发"Continue"促动
# （挂接在空回复的 parent 消息上），最多连续促动 N 次；续写内容流入
# 同一条回复流，客户端看到的答案无缝衔接。
# 续写轮同样计入 REQUESTS_PER_SESSION 与日配额。默认关闭
AUTO_CONTINUATION=false
AUTO_CONTINUATION_MAX=2

# 风控可观测：按该间隔向主日志输出风控摘要（全局 请求/新建会话/缓存命中，
# 每账号 成功完成数/429 连撞/冷却与 BAN 保持剩余/日配额用量/在途）。
# 0 = 关（默认）；建议 30m，配合 LOG_FILE 落盘可长期观察账号风险趋势
RISK_STATS_INTERVAL=0

# ─── Agent 加固（工具解析 / 思考兜底） ─────────────────────────────

# 裸 JSON 工具调用嗅探（双判据：工具名在白名单 且 带 arguments 键）
# 默认关闭：防止把回答里的普通 JSON / 代码示例误判成工具调用
TOOL_JSON_FALLBACK=false

# 空正文兜底：正文为空而思考块有内容时，把思考内容补进正文
# （网页模型偶尔把最终答案写进 THINK 块，避免客户端收到空回复）
REASONING_FALLBACK=true

# ─── 任务级账号分发（会话起点指纹路由） ─────────────────────────────

# 默认关闭 = 现有行为（策略3最近会话兜底，所有任务共用一个会话/账号）。
# 开启后：
#   - 任务第一回合（消息里没有 assistant）→ 必然新建网页会话 + 轮询到下一个账号
#   - 任务进行中（带完整历史）→ 按「系统+首条指令+首轮回复」指纹回到本任务的会话/账号
#   - 效果：任务a→账号A，任务b→账号B，任务c→账号A……风控按任务数摊薄；
#     任务内单会话单账号、零重放成本
#   - 注意：开启后「无 assistant 历史」的请求不再走最近会话兜底（每次新建会话）
CONV_FINGERPRINT_ROUTE=false

# ─── 会话持久化（任务跨重启继续） ─────────────────────────────────

# 默认关闭。开启后把「会话索引」（前缀键 / 指纹键 / 会话ID → 会话记录，
# 含所属账号）快照到本地 data 目录，服务重启后自动恢复：
#   - 进行中的任务继续命中同一网页会话与同一账号（任务a→账号A 不丢失）
#   - 5 秒节流 + 原子写盘；关机前强制 flush
# 恢复时自动丢弃：已超空闲 TTL 的会话、账号已失效/被删的会话。
PERSIST_SESSIONS=false

# 数据目录（持久化文件所在文件夹）。留空 = 自动放在日志同层的 data 目录
# （LOG_FILE=/app/logs/app.log → /app/data；无 LOG_FILE → 当前目录 ./data）
# 持久化文件固定为 <DATA_DIR>/conversations.json
DATA_DIR=
