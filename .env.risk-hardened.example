# ╔══════════════════════════════════════════════════════════════════╗
# ║          抗风控最佳实践预设（长期挂机 · 多账号 · 任务隔离）         ║
# ║                                                                  ║
# ║  用法：复制本文件为 .env（变量覆盖 .env.example 的默认值）：       ║
# ║    cp .env.risk-hardened.example .env                             ║
# ║  前提：accounts.txt 里至少 2 个账号（建议 4 个以上）。           ║
# ║                                                                  ║
# ║  三层防护：                                                      ║
# ║   1. 行为层 —— QPM/并发/阅读间隔/长停顿/设备轮换，请求节奏拟人    ║
# ║   2. 账号层 —— 每账号日配额 + 封禁熔断 + 429 指数退避自动漂移    ║
# ║   3. 任务层 —— 指纹路由 + 会话持久化 + 静默自动续写，任务与账号   ║
# ║      固定绑定、零重放，风险按任务数摊薄                           ║
# ╚══════════════════════════════════════════════════════════════════╝

# ─── 必需：代理密钥（多客户端隔离） ────────────────────────────────
# 每类客户端一个独立 key（思源 / opencode / 其它），各自会话彻底隔离、
# 互不串台。群晖挂 ./proxy-keys.txt:/app/proxy-keys.txt:ro
PROXY_API_KEY=my-secret-key
PROXY_KEYS_FILE=proxy-keys.txt

# ─── 账号：多账号池（≥2，建议 ≥4） ─────────────────────────────────
# 单账号是最大风险点：日配额、429、封禁都靠多账号摊薄。
DEEPSEEK_TOKEN=
DEEPSEEK_ACCOUNTS_FILE=accounts.txt

# ─── 服务基础 ──────────────────────────────────────────────────────
PORT=8080
DEEPSEEK_BASE_URL=https://chat.deepseek.com
DEFAULT_MODEL=deepseek-chat

# ─── 行为层：拟人节奏（第一道防线） ────────────────────────────────
# 每账号每分钟最多 4 条（正常人 1~6 QPM；留出 429 余量，默认 6 偏紧）
ACCOUNT_QPM=4
# 每账号同时在线的网页会话上限：3（默认 5 偏激进，超了就加账号）
MAX_CONCURRENT_PER_ACCOUNT=3
# 同账号两次请求之间等 5~30s（模拟读回复再发下一条）
REQUEST_READ_TIME_MIN=5s
REQUEST_READ_TIME_MAX=30s
# 2% 概率额外随机停 20~60s（"去倒杯水"长尾；agent 工具循环豁免）
LONG_PAUSE_CHANCE=0.02
# 请求前随机 200~800ms、POW 求解 30~150ms、建会话前 200ms（打齐指纹）
REQUEST_JITTER_MIN=200ms
REQUEST_JITTER_MAX=800ms
POW_JITTER_MIN=30ms
POW_JITTER_MAX=150ms
SESSION_CREATE_JITTER=200ms
# 设备指纹每 72h 轮换一次（新请求换 deviceID，长期挂机不留旧指纹）
DEVICE_ID_ROTATE_HOURS=72

# 429 重试：同账号指数退避 2s→4s→8s（账号级 60s×2^n 升级冷却为内置）
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY=2s

# ─── 账号层：配额 + 熔断（第二道防线） ──────────────────────────────
# 每账号每天 ≤150 次请求（本地日归零、落盘重启不清零；达标自动漂移，
# 全池达标时新会话 503，午夜恢复）
DAILY_REQUEST_LIMIT=150
# 封禁措辞熔断：已封账号保持 7 天不戳（避免反复探测加重风控）
BAN_QUARANTINE_HOURS=168
# token 健康探测：启动全探 + 每 30m 探存活 + 每 10m 探隔离（自动复活）
STARTUP_ACCOUNT_CHECK=true
HEALTH_PROBE_INTERVAL=30m
HEALTH_PROBE_DEAD_RETRY=10m
HEALTH_LOG_FILE=

# ─── 任务层：任务↔账号固定绑定（第三道防线） ───────────────────────
# 任务第一回合必新建会话并轮询到下一个账号；进行中按「系统+首指令+
# 首轮回复」指纹回绑本任务会话/账号 → 任务a→账号A、任务b→账号B，
# 单任务内零重放历史（重放长历史是最大的机器特征）
CONV_FINGERPRINT_ROUTE=true
# 会话索引落盘，服务重启后任务继续命中同一网页会话与账号
PERSIST_SESSIONS=true
# DATA_DIR 留空 = 自动（compose 里 ./data 已挂载）
DATA_DIR=
# 会话内确定性控制：40 轮强制换新会话（比 SESSION_RESET_CHANCE 随机
# 更稳；新建会话是昂贵且易被指纹识别的动作，40 轮已是相当长的寿命）
REQUESTS_PER_SESSION=40
SESSION_RESET_CHANCE=0
# 会话 TTL 随机化（10m/60m/2h/5h/永不 各 1/5），打乱删除节奏
CONVERSATION_TTL_OPTIONS=10m,60m,2h,5h,0
MAX_CONVERSATIONS=1024

# 静默自动续写：上游"成功但静默"的空回复自动在同会话发 "Continue"
# （治长任务静默卡死；最多连续 2 次，续写轮计入会话轮次与日配额）
AUTO_CONTINUATION=true
AUTO_CONTINUATION_MAX=2

# ─── 可观测：风险趋势一目了然 ──────────────────────────────────────
# 每 30m 向主日志输出风控摘要（全局 新建/命中比 + 每账号 完成数/429
# 连撞/冷却与 BAN 剩余/日配额用量/在途）。盯两点：
#   · sessions_created / cache_hits 比值升高 → 收紧 QPM 或加大阅读间隔
#   · 某账号 429 连撞持续 → 降 ACCOUNT_QPM 或加账号
RISK_STATS_INTERVAL=30m
LOG_FILE=/app/logs/app.log

# ─── Agent 加固（保持默认值即可） ─────────────────────────────────
TOOL_JSON_FALLBACK=false
REASONING_FALLBACK=true
